TELEGRAM_BOT_TOKEN=replace_with_token_from_botfather
BACKEND_BASE_URL=https://localhost:7249
BACKEND_SERVICE_PASSWORD=SUPER_LONG_SECRET_KEY_FOR_VIA_TRADE_SUPER_LONG_SECRET_KEY_FOR_VIA_TRADE
BACKEND_REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_MESSAGE_RATE_LIMIT_SECONDS=1
REDIS_URL=redis://127.0.0.1:6379/1
NOTIFICATION_STREAM=telegram:notifications
NOTIFICATION_CONSUMER_GROUP=viatrade-telegram-bot
NOTIFICATION_READ_BLOCK_MS=5000
NOTIFICATION_READ_COUNT=10
NOTIFICATION_CLAIM_IDLE_MS=60000
NOTIFICATION_DELIVERY_LOCK_TTL_SECONDS=300
NOTIFICATION_RECOVERY_INTERVAL_SECONDS=30
NOTIFICATION_DEDUPLICATION_TTL_SECONDS=604800
NOTIFICATION_SHUTDOWN_GRACE_SECONDS=90
LOG_LEVEL=INFO
